            print(e)

    elif choice == "2":

        sender = input("Enter sender system: ")
        receiver = input("Enter receiver system: ")
        message = input("Enter message: ")

        try:
            receiver_public, _ = km.get_public_keys(receiver)

            encrypted = rsa_encrypt(message, receiver_public)

            receiver_private = km.systems[receiver]["rsa_private"]

            decrypted = rsa_decrypt(
                encrypted,
                receiver_private
            )

            print("\nEncrypted message:", encrypted.hex())
            print("Decrypted message:", decrypted)

        except ValueError as e:
